# Copy to .env on the VM and fill in. Never commit .env.
S3_ACCESS_KEY=lakewire
S3_SECRET_KEY=generated-by-bootstrap_vm.sh
LAKE_BUCKET=lake

# Wikimedia asks automated clients for a descriptive User-Agent with contact details.
USER_AGENT=Lakewire/1.0 (https://github.com/YOUR_USER/lakewire; you@example.com)

# Which wikis to ingest (comma separated). Keep this small: it controls disk use.
WIKIS=enwiki,dewiki,frwiki,eswiki,jawiki

# Pageviews: keep only these domain codes, and the top N pages per hour.
PAGEVIEW_DOMAINS=en,en.m
PAGEVIEW_TOP_N=50000
PAGEVIEWS_START_DATE=2026-11-10

# Retention keeps the 200 GB free disk from filling up.
BRONZE_RETENTION_DAYS=14
SILVER_RETENTION_DAYS=120

# Optional: Slack incoming webhook for Airflow failure alerts.
SLACK_WEBHOOK_URL=

GRAFANA_ADMIN_PASSWORD=generated-by-bootstrap_vm.sh
